    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=Du bist ein Buchhaltungs-Assistent. Extrahiere aus dem folgenden Rechnungstext die Daten und gib AUSSCHLIESSLICH ein JSON-Objekt zurück, ohne Erklärung, ohne Markdown. Felder: lieferant, rechnungsnummer, rechnungsdatum (YYYY-MM-DD), faelligkeit (YYYY-MM-DD), netto (Zahl), mwst (Zahl), brutto (Zahl), iban. Wenn ein Feld fehlt, setze null.\n\nRechnungstext:\n{{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [
        -1152,
        -128
      ],
      "id": "e03878ae-1422-4303-9199-14315173d5f4",
      "name": "KI-Auslese (GPT-4o-mini)",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const inp = $input.first().json;\n\n// Rohtext an allen möglichen Stellen suchen\nlet roh =\n  inp.output?.[0]?.content?.[0]?.text ??\n  inp.output?.content ??\n  inp.message?.content ??\n  inp.text ??\n  inp.output ??\n  inp;\n\n// \"```json ... ```\" abstreifen, falls vorhanden\nif (typeof roh === 'string') {\n  roh = roh.replace(/```json/gi, '').replace(/```/g, '').trim();\n}\n\n// Wenn die KI kein gültiges JSON liefert, nicht abbrechen,\n// sondern leere Felder weitergeben -> die Prüfung markiert das als Fehler.\nlet daten = {};\nlet parseFehler = false;\ntry {\n  daten = typeof roh === 'string' ? JSON.parse(roh) : (roh || {});\n} catch (e) {\n  parseFehler = true;\n  daten = {};\n}\n\nreturn [{\n  json: {\n    lieferant: daten.lieferant ?? null,\n    rechnungsnummer: daten.rechnungsnummer ?? null,\n    rechnungsdatum: daten.rechnungsdatum ?? null,\n    faelligkeit: daten.faelligkeit ?? null,\n    netto: daten.netto ?? null,\n    mwst: daten.mwst ?? null,\n    brutto: daten.brutto ?? null,\n    iban: daten.iban ?? null,\n    parse_fehler: parseFehler,\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        -128
      ],
