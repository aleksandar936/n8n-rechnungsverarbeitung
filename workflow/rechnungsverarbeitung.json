    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\n\n// Ergebnis des Dublettencheck-Nodes nachschlagen (läuft als Seitenzweig).\n// Wenn nichts gefunden wurde, ist treffer leer -> keine Dublette.\nlet treffer = [];\ntry {\n  treffer = $('Get row(s)').all()\n    .map(i => i.json)\n    .filter(j => j && j.id !== undefined && j.id !== null && j.id !== '')\n    // nur echte Treffer mit derselben Rechnungsnummer zählen\n    .filter(j => String(j.rechnungsnummer) === String(r.rechnungsnummer));\n} catch (e) {\n  treffer = [];\n}\n\n// Ohne erkannte Rechnungsnummer ist kein Dublettencheck möglich (Status ist dann schon \"Fehler\").\nconst schonVorhanden = Boolean(r.rechnungsnummer) && treffer.length > 0;\n\nlet status = r.status;\nlet hinweis = r.pruefhinweis;\n\nif (schonVorhanden) {\n  status = 'Dublette';\n  hinweis = `Rechnungsnummer ${r.rechnungsnummer} existiert bereits (id ${treffer[0].id}) - nicht erneut verbucht.`;\n}\n\nreturn [{ json: { ...r, status, pruefhinweis: hinweis } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
