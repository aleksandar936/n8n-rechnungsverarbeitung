    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\n\n// Zahl oder null (leere Felder dürfen NICHT als 0 durchrutschen)\nconst zahl = v => (v === null || v === undefined || v === '' || !Number.isFinite(Number(v))) ? null : Number(v);\nconst netto = zahl(r.netto);\nconst mwst = zahl(r.mwst);\nconst brutto = zahl(r.brutto);\n\n// Pflichtfelder prüfen, bevor irgendetwas gerechnet wird\nconst fehlend = [];\nif (!r.rechnungsnummer) fehlend.push('Rechnungsnummer');\nif (netto === null) fehlend.push('Netto');\nif (mwst === null) fehlend.push('MwSt');\nif (brutto === null) fehlend.push('Brutto');\n\nlet status, hinweis;\nif (r.parse_fehler) {\n  status = 'Fehler';\n  hinweis = 'KI-Antwort war kein gültiges JSON – Rechnung manuell prüfen.';\n} else if (fehlend.length > 0) {\n  status = 'Fehler';\n  hinweis = `Pflichtfeld(er) nicht erkannt: ${fehlend.join(', ')}.`;\n} else if (Math.abs((netto + mwst) - brutto) >= 0.02) {\n  // Rechen-Check (kleine Rundungstoleranz)\n  status = 'Fehler';\n  hinweis = `Rechenfehler: ${netto} + ${mwst} = ${(netto + mwst).toFixed(2)}, brutto = ${brutto}.`;\n} else if (netto >= 1000) {\n  // Freigabe-Schwelle: ab 1.000 € netto\n  status = 'Freigabe nötig';\n  hinweis = `Netto ${netto} € ab 1.000 € – Freigabe erforderlich.`;\n} else {\n  status = 'Bereit zum Verbuchen';\n  hinweis = 'Alle Prüfungen bestanden.';\n}\n\nconst { parse_fehler, ...rest } = r;\nreturn [{ json: { ...rest, netto, mwst, brutto, status, pruefhinweis: hinweis } }];\n"
      },
